#!/usr/bin/env bash
# 구현 사이클 마무리: CI 대기 → 스쿼시 머지 → 워크트리·로컬 브랜치 정리 → main 갱신 → 다음 후보 출력.
# 메인 체크아웃에서 실행한다. 원격 브랜치는 저장소 설정(delete_branch_on_merge)이 지운다.
# 사용: scripts/cycle-finish <PR번호> [--wait-only]
#   --wait-only  CI만 기다리고 머지하지 않는다(민감 티켓: 사용자 승인 뒤 다시 실행).
# 종료 코드: 0 완료, 1 CI 실패·머지 불가, 2 사용 오류.
# 전제: CI 워크플로 잡 이름 `checks`가 체크 이름으로 등록된다(gh pr checks의 name). 잡 이름이 바뀌면 이 스크립트도 바꾼다.
# 체크 등록 대기 간격·횟수: CYCLE_FINISH_POLL_SECONDS(기본 5)·CYCLE_FINISH_POLL_TRIES(기본 24).
set -euo pipefail

usage() { echo "사용: scripts/cycle-finish <PR번호> [--wait-only]" >&2; exit 2; }
pr=""; wait_only=0
while [ $# -gt 0 ]; do
  case "$1" in
    --wait-only) wait_only=1 ;;
    -h|--help) usage ;;
    *) [ -z "$pr" ] && pr="$1" || usage ;;
  esac
  shift
done
[[ "$pr" =~ ^[0-9]+$ ]] || usage

cd "$(git rev-parse --show-toplevel)"
branch="$(gh pr view "$pr" --json headRefName --jq .headRefName)"
echo "PR #$pr ($branch): CI 대기"
# push 직후에는 체크가 아직 등록되지 않고 Vercel이 CI 잡보다 먼저 나타나므로 CI 잡 checks가 나타날 때까지 최대 2분 기다린다.
registered=0
for _ in $(seq 1 "${CYCLE_FINISH_POLL_TRIES:-24}"); do
  names="$(gh pr checks "$pr" --json name --jq '.[].name' 2>/dev/null)" || names=""
  if grep -qx checks <<<"$names"; then
    registered=1; break
  fi
  sleep "${CYCLE_FINISH_POLL_SECONDS:-5}"
done
[ "$registered" -eq 1 ] || { echo "FAIL: CI 잡 checks가 등록되지 않음"; gh pr checks "$pr" || true; exit 1; }
# 기다리기만 --watch에 맡긴다. gh는 취소된 체크에도 0을 돌려주므로 판정은 bucket으로 한다(pass·skipping 밖은 실패).
gh pr checks "$pr" --watch --fail-fast || true
bad="$(gh pr checks "$pr" --json name,bucket --jq '[.[] | select(.bucket != "pass" and .bucket != "skipping")] | length')" || bad=err
if [ "$bad" != "0" ]; then
  echo "FAIL: CI 실패"; gh pr checks "$pr" || true; exit 1
fi
[ "$wait_only" -eq 1 ] && { echo "PASS (CI만 확인, 머지 안 함)"; exit 0; }

# 다른 PR 머지 직후에는 GitHub이 mergeable을 재계산하므로 UNKNOWN이 풀릴 때까지 기다린다.
state=UNKNOWN
for _ in $(seq 1 12); do
  state="$(gh pr view "$pr" --json mergeable --jq .mergeable)"
  [ "$state" = "UNKNOWN" ] || break
  sleep 5
done
[ "$state" = "MERGEABLE" ] || { echo "FAIL: mergeable=$state"; exit 1; }
gh pr merge "$pr" --squash
echo "머지 완료"

wt="$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '/^worktree /{p=substr($0,10)} $0=="branch "b{print p}')"
if [ -n "$wt" ] && [ "$wt" != "$PWD" ]; then
  git worktree remove --force "$wt"
  docker exec newsplatform-test-db dropdb -h localhost -U test --if-exists "newsplatform_test_$(basename "$wt" | tr -c 'a-zA-Z0-9_\n' '_')" >/dev/null 2>&1 || true
fi
[ "$(git rev-parse --abbrev-ref HEAD)" = "$branch" ] && git checkout -q main
git pull -q --ff-only origin main
git branch -D "$branch" >/dev/null 2>&1 || true
rm -rf .superpowers docs/superpowers/plans

next="$(gh issue list --state open --label ready-for-agent --limit 50 --json number,labels,assignees \
  --jq '[.[] | select((.labels|map(.name)|index("research"))==null and (.assignees|length)==0) | .number] | sort | map("#\(.)") | join(" ")')"
if [ -n "$next" ]; then
  echo "다음 후보(차단은 cycle-start가 확인): $next"
else
  echo "큐 비었음"
fi
