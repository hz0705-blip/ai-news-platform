#!/usr/bin/env bash
# 구현 사이클 착수: 티켓 게이트를 확인하고 통과하면 클레임 + 워크트리(브랜치) 생성 + 의존성 설치.
# 워크트리는 저장소 옆 ../ai-news-platform-wt/<이슈>에 origin/main에서 만든다. .env는 메인 체크아웃 것을 링크한다.
# 메인 체크아웃에서 실행한다(main에 두고 편집하지 않는다).
# 사용: scripts/cycle-start <이슈번호> [--check-only] [--slug <slug>]
# 게이트: 이슈 OPEN, ready-for-agent 있음, research/needs-triage/needs-info 없음, 담당자 없음,
#         열린 차단 이슈 없음(GitHub 의존성 + 본문 "리서치 대기 #N"), 메인 체크아웃이 main이고 깨끗, main 최신.
# 종료 코드: 0 통과, 1 게이트 실패, 2 사용 오류.
set -euo pipefail

usage() { echo "사용: scripts/cycle-start <이슈번호> [--check-only] [--slug <slug>]" >&2; exit 2; }

issue=""; check_only=0; slug=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check-only) check_only=1 ;;
    --slug) shift; slug="${1:-}" ;;
    -h|--help) usage ;;
    *) [ -z "$issue" ] && issue="$1" || usage ;;
  esac
  shift
done
[[ "$issue" =~ ^[0-9]+$ ]] || usage

cd "$(git rev-parse --show-toplevel)"
repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
fails=()

# 1. 이슈 게이트
json="$(gh issue view "$issue" --json state,title,labels,assignees,body)"
state="$(jq -r .state <<<"$json")"
title="$(jq -r .title <<<"$json")"
labels="$(jq -r '.labels[].name' <<<"$json")"
assignees="$(jq -r '.assignees[].login' <<<"$json")"
body="$(jq -r .body <<<"$json")"

[ "$state" = "OPEN" ] || fails+=("이슈 상태 $state (OPEN 아님)")
grep -qx 'ready-for-agent' <<<"$labels" || fails+=("ready-for-agent 라벨 없음")
for bad in research needs-triage needs-info; do
  grep -qx "$bad" <<<"$labels" && fails+=("라벨 '$bad' 있음 — Claude 구현 사이클 대상 아님")
done
[ -z "$assignees" ] || fails+=("담당자 있음: $(tr '\n' ' ' <<<"$assignees")")

open_blockers="$(gh api "repos/$repo/issues/$issue/dependencies/blocked_by" --jq '[.[] | select(.state=="open") | "#\(.number)"] | join(", ")' 2>/dev/null || true)"
[ -z "$open_blockers" ] || fails+=("열린 차단 이슈: $open_blockers")

for ref in $(grep -oE '리서치 대기 #[0-9]+' <<<"$body" | grep -oE '[0-9]+' | sort -u); do
  rstate="$(gh issue view "$ref" --json state --jq .state 2>/dev/null || echo UNKNOWN)"
  [ "$rstate" = "CLOSED" ] || fails+=("본문 '리서치 대기 #$ref'가 $rstate")
done

# 2. 메인 체크아웃·main
[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || fails+=("연결된 워크트리 안에서 실행함 — 메인 체크아웃에서 실행")
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || fails+=("메인 체크아웃이 main이 아님")
[ -z "$(git status --porcelain)" ] || fails+=("작업 트리에 변경이 있음")
git fetch --quiet origin main
[ "$(git rev-parse origin/main)" = "$(git rev-parse main)" ] || fails+=("로컬 main이 origin/main과 다름")

# 3. 브랜치명
if [ -z "$slug" ]; then
  slug="$(tr '[:upper:]' '[:lower:]' <<<"$title" | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' | cut -c1-40 | sed -E 's/-+$//')"
  [ -n "$slug" ] || slug="issue"
fi
branch="ticket/$issue-$slug"
git show-ref --verify --quiet "refs/heads/$branch" && fails+=("브랜치 $branch가 이미 존재함")
wt="$(dirname "$PWD")/$(basename "$PWD")-wt/$issue"
[ -e "$wt" ] && fails+=("워크트리 경로 $wt가 이미 있음")
port=$((3200 + issue % 800))

echo "#$issue $title"
if [ ${#fails[@]} -gt 0 ]; then
  echo "FAIL (${#fails[@]})"
  printf '  - %s\n' "${fails[@]}"
  exit 1
fi

if [ "$check_only" -eq 1 ]; then
  echo "PASS (확인만, 클레임·브랜치 안 함)"
  echo "branch: $branch"
  echo "worktree: $wt"
  exit 0
fi

gh issue edit "$issue" --add-assignee @me >/dev/null
git worktree add -q -b "$branch" "$wt" origin/main
[ -f .env ] && ln -s "$PWD/.env" "$wt/.env"
(cd "$wt" && pnpm install --frozen-lockfile --prefer-offline >/dev/null)
echo "PASS — 클레임 완료(@me), branch: $branch"
echo "worktree: $wt"
echo "E2E_PORT=$port (pnpm test:db는 워크트리 전용 DB newsplatform_test_$issue를 쓴다)"
echo "다음: 이슈 본문을 브리프로 구현 서브에이전트 착수 (CLAUDE.md 구현 사이클 2)"
