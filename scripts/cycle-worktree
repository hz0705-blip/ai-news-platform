#!/usr/bin/env bash
# EnterWorktree 직후 워크트리 안에서 실행: 브랜치 이름 변경, 설정 파일 확인, .env 복사.
# 사용: scripts/cycle-worktree <이슈번호> <slug>
# 종료 코드: 0 준비 완료, 1 확인 실패, 2 사용 오류.
set -euo pipefail

issue="${1:-}"; slug="${2:-}"
[[ "$issue" =~ ^[0-9]+$ ]] && [ -n "$slug" ] || { echo "사용: scripts/cycle-worktree <이슈번호> <slug>" >&2; exit 2; }

here="$(git rev-parse --show-toplevel)"
common="$(git rev-parse --git-common-dir)"
main_root="$(git worktree list --porcelain | awk 'NR==1 && /^worktree /{sub(/^worktree /,""); print}')"
if [ "$here" = "$main_root" ]; then
  echo "FAIL: 메인 체크아웃($here)에서 실행됨. 워크트리 안에서 실행한다." >&2; exit 1
fi
fails=()

# 브랜치 이름
target="ticket/$issue-$slug"
current="$(git rev-parse --abbrev-ref HEAD)"
if [ "$current" = "$target" ]; then
  echo "branch: $target (이미 설정됨)"
elif git show-ref --verify --quiet "refs/heads/$target"; then
  fails+=("브랜치 $target가 이미 존재함(현재 $current)")
else
  git branch -m "$target"
  echo "branch: $current → $target"
fi

# 설정 파일 존재
for f in .claude/settings.json .gitignore; do
  [ -f "$here/$f" ] && echo "ok: $f" || fails+=("$f 없음 — main에 있어야 워크트리에 들어온다")
done

# .env 복사
if [ -f "$here/.env" ]; then
  echo "ok: .env (이미 있음)"
elif [ -f "$main_root/.env" ]; then
  cp "$main_root/.env" "$here/.env"
  echo "ok: .env 복사($main_root/.env)"
else
  echo "warn: 메인 체크아웃에 .env 없음 — db:migrate·db:gate는 실행 불가"
fi

[ -d "$here/node_modules" ] || echo "hint: node_modules 없음 — 필요하면 pnpm install --frozen-lockfile"

if [ ${#fails[@]} -gt 0 ]; then
  echo "FAIL (${#fails[@]})"; printf '  - %s\n' "${fails[@]}"; exit 1
fi
echo "READY: $here ($target). 다음: superpowers:writing-plans → docs/superpowers/plans/$(date +%F)-$issue-$slug.md"
