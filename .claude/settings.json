{
  "permissions": {
    "deny": [
      "Skill(superpowers:brainstorming)",
      "Skill(superpowers:brainstorming *)",
      "Skill(superpowers:writing-skills)",
      "Skill(superpowers:writing-skills *)"
    ],
    "allow": [
      "Bash(herdr agent list *)",
      "Bash(herdr agent list)",
      "Bash(herdr agent get *)",
      "Bash(herdr agent read *)",
      "Bash(herdr agent wait *)",
      "Bash(herdr agent explain *)",
      "Bash(herdr pane list *)",
      "Bash(herdr pane get *)",
      "Bash(herdr pane read *)",
      "Bash(herdr pane layout *)",
      "Bash(herdr pane current *)",
      "Bash(herdr pane wait-output *)",
      "Bash(git fetch *)",
      "Bash(git worktree list *)",
      "Bash(claude plugin list)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm view *)",
      "Bash(scripts/cycle-start *)",
      "Bash(scripts/cycle-worktree *)",
      "Bash(scripts/handoff-state)",
      "Bash(scripts/agent-monitor *)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/handoff-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/handoff-start.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-monitor-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
