{
  "permissions": {
    "deny": [
      "Skill(superpowers:brainstorming)",
      "Skill(superpowers:brainstorming *)",
      "Skill(superpowers:writing-skills)",
      "Skill(superpowers:writing-skills *)",
      "Skill(superpowers:using-git-worktrees)",
      "Skill(superpowers:using-git-worktrees *)",
      "Skill(superpowers:writing-plans)",
      "Skill(superpowers:writing-plans *)",
      "Skill(superpowers:subagent-driven-development)",
      "Skill(superpowers:subagent-driven-development *)"
    ],
    "allow": [
      "Bash(herdr agent list *)",
      "Bash(herdr agent list)",
      "Bash(herdr agent get *)",
      "Bash(herdr agent read *)",
      "Bash(herdr agent wait *)",
      "Bash(herdr agent explain *)",
      "Bash(herdr pane list *)",
      "Bash(herdr pane get *)",
      "Bash(herdr pane read *)",
      "Bash(herdr pane layout *)",
      "Bash(herdr pane current *)",
      "Bash(herdr pane wait-output *)",
      "Bash(git fetch *)",
      "Bash(claude plugin list)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm view *)",
      "Bash(scripts/cycle-start *)",
      "Bash(scripts/handoff-state)",
      "Bash(scripts/agent-monitor *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr comment *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(scripts/cycle-finish *)",
      "Bash(pnpm test:db)",
      "Bash(pnpm --filter * test:e2e)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/handoff-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/handoff-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-monitor-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
