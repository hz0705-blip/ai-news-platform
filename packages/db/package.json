{
  "name": "@newsplatform/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migration:generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "gate:pgvector": "node --env-file-if-exists=../../.env scripts/pgvector-gate.ts",
    "backup:encrypt": "node --env-file-if-exists=../../.env scripts/backup-encrypt.ts",
    "backup:decrypt": "node --env-file-if-exists=../../.env scripts/backup-decrypt.ts"
  },
  "dependencies": {
    "@newsplatform/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
