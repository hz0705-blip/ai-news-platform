{
  "name": "@newstrail/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./provider-unlink": "./src/account/provider-unlink.ts",
    "./embedding": "./src/openai/embedding.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "eval:export": "node --env-file-if-exists=../../.env scripts/eval-export.ts",
    "eval:draft": "node --env-file-if-exists=../../.env scripts/eval-draft.ts",
    "eval:compare": "node --env-file-if-exists=../../.env scripts/eval-compare.ts",
    "eval:adjudicate": "node --env-file-if-exists=../../.env scripts/eval-adjudicate.ts",
    "eval:run": "node --env-file-if-exists=../../.env scripts/eval-run.ts",
    "eval:score": "node --env-file-if-exists=../../.env scripts/eval-score.ts"
  },
  "dependencies": {
    "@newstrail/domain": "workspace:*",
    "openai": "7.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "postgres": "3.4.9"
  }
}
