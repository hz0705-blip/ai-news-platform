# 로컬 실행용. 값은 여기 쓰지 않는다. .env는 .gitignore로 무시된다.
# 런타임(웹): Supabase 트랜잭션 풀러(aws-0-<region>.pooler.supabase.com), 포트 6543, 사용자 postgres.<ref>
DATABASE_URL=
# 마이그레이션·게이트: Supabase 세션 풀러(aws-0-<region>.pooler.supabase.com), 포트 5432, 사용자 postgres.<ref>. 직접 연결 호스트는 IPv6 전용이라 쓰지 않는다. 웹·워커 런타임은 이 값을 읽지 않는다.
DATABASE_MIGRATION_URL=
# 실 DB 테스트(pnpm test:db, 이슈 #42) 전용. localhost 컨테이너만 받는다(supabase·원격 호스트는 테스트가 거부). pnpm test:db는 이 값을 스스로 정하므로 비워 둬도 된다.
# 예: postgresql://test:test@localhost:54329/newsplatform_test (scripts/test-db의 컨테이너 newsplatform-test-db)
DATABASE_TEST_URL=
# 백업 복호화(로컬 복구 절차 전용, 이슈 #18). GitHub 환경 Production의 시크릿과 같은 값. 32바이트를 64자 hex로: openssl rand -hex 32. 정본은 비밀번호 관리자, 이 파일의 사본은 복구 훈련 전용.
BACKUP_ENCRYPTION_KEY=
# GNews Essential API 키(수집, 이슈 #52). 일 1,000회 한도. 값을 로그·픽스처에 남기지 않는다.
GNEWS_API_KEY=
# OpenAI API 키(임베딩·사건 배정 #53, 모델 호출 #54). 값을 로그·픽스처에 남기지 않는다.
OPENAI_API_KEY=
# 워커 데몬(#55, pnpm --filter @newsplatform/worker start)의 연결. Supabase 세션 풀러(aws-0-<region>.pooler.supabase.com) 5432, 사용자 postgres.<ref>.
# pg-boss 스키마(pgboss)와 배치가 같은 연결 문자열을 쓴다. 트랜잭션 풀러(6543)는 쓰지 않는다. 수동 명령(batch:run)은 DATABASE_MIGRATION_URL을 읽는다.
WORKER_DATABASE_URL=
# 발행 뒤 웹 캐시 무효화(#55). 워커가 POST <WEB_REVALIDATE_URL>(예 https://<web>/api/revalidate)에 Bearer REVALIDATE_SECRET으로 태그를 보낸다.
# 웹은 REVALIDATE_SECRET만 읽는다. 둘 다 비어 있으면 워커는 무효화를 건너뛴다(로컬). 값은 openssl rand -hex 32.
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
# 파이프라인 일일 예산 덮어쓰기(USD, 양의 소수, #64). 비우면 스펙 값 1.20. 잘못된 값이면 워커·batch:run이 시작하지 않는다. 출시 전 개발 값은 스펙 "개발 중 결정 항목" 토큰 계량 줄.
PIPELINE_DAILY_BUDGET_USD=
# 모델 응답 기록 모드(#54, packages/pipeline/scripts/record-model-responses.ts). 1이면 실제 응답을 fixtures/<slug>/recorded/에 쓴다. 평소에는 비워 둔다.
PIPELINE_RECORD=
