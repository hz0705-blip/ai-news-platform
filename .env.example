# 로컬 실행용. 값은 여기 쓰지 않는다. .env는 .gitignore로 무시된다.
# 런타임(웹): Supabase 트랜잭션 풀러(aws-0-<region>.pooler.supabase.com), 포트 6543, 사용자 postgres.<ref>
DATABASE_URL=
# 마이그레이션·게이트: Supabase 세션 풀러(aws-0-<region>.pooler.supabase.com), 포트 5432, 사용자 postgres.<ref>. 직접 연결 호스트는 IPv6 전용이라 쓰지 않는다. 웹·워커 런타임은 이 값을 읽지 않는다.
DATABASE_MIGRATION_URL=
# 실 DB 테스트(pnpm test:db, 이슈 #42) 전용. localhost 컨테이너만 받는다(supabase·원격 호스트는 테스트가 거부). pnpm test:db는 이 값을 스스로 정하므로 비워 둬도 된다.
# 예: postgresql://test:test@localhost:54329/newsplatform_test (scripts/test-db의 컨테이너 newsplatform-test-db)
DATABASE_TEST_URL=
# 백업 복호화(로컬 복구 절차 전용, 이슈 #18). GitHub 환경 Production의 시크릿과 같은 값. 32바이트를 64자 hex로: openssl rand -hex 32. 정본은 비밀번호 관리자, 이 파일의 사본은 복구 훈련 전용.
BACKUP_ENCRYPTION_KEY=
# GNews Essential API 키(수집, 이슈 #52). 일 1,000회 한도. 값을 로그·픽스처에 남기지 않는다.
GNEWS_API_KEY=
# OpenAI API 키(임베딩·사건 배정 #53, 모델 호출 #54, 웹 검색 질의 임베딩 #125). 값을 로그·픽스처에 남기지 않는다.
OPENAI_API_KEY=
# 워커 데몬(#55, pnpm --filter @newstrail/worker start)의 연결. Supabase 세션 풀러(aws-0-<region>.pooler.supabase.com) 5432, 사용자 postgres.<ref>.
# pg-boss 스키마(pgboss)와 배치가 같은 연결 문자열을 쓴다. 트랜잭션 풀러(6543)는 쓰지 않는다. 수동 명령(batch:run)은 DATABASE_MIGRATION_URL을 읽는다.
WORKER_DATABASE_URL=
# 발행 뒤 웹 캐시 무효화(#55). 워커가 POST <WEB_REVALIDATE_URL>(예 https://<web>/api/revalidate)에 Bearer REVALIDATE_SECRET으로 태그를 보낸다.
# 웹은 REVALIDATE_SECRET만 읽는다. 둘 다 비어 있으면 워커는 무효화를 건너뛴다(로컬). 값은 openssl rand -hex 32.
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
# 파이프라인 일일 예산 덮어쓰기(USD, 양의 소수, #64). 비우면 스펙 값 1.20. 잘못된 값이면 워커·batch:run이 시작하지 않는다. 출시 전 개발 값은 스펙 "개발 중 결정 항목" 토큰 계량 줄.
PIPELINE_DAILY_BUDGET_USD=
# 모델 응답 기록 모드(#54, packages/pipeline/scripts/record-model-responses.ts). 1이면 실제 응답을 fixtures/<slug>/recorded/에 쓴다. 평소에는 비워 둔다.
PIPELINE_RECORD=
# Supabase Auth(#104, 웹). URL·publishable 키는 브라우저에 공개되는 값이며 빌드 때 들어간다(NEXT_PUBLIC_). 비우면 로그인만 쓸 수 없고 공개 화면은 그대로다.
# 로컬·E2E는 로컬 Supabase CLI 값(docs/agents/project.md 명령어), 프로덕션 값은 Supabase 프로젝트 API 설정.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret 키(서버 전용, 관리자 권한). 웹에서는 계정 삭제 서버 코드 밖에서 읽지 않는다(스펙 "계정" 관리자 키). E2E는 테스트 사용자 생성(auth.admin)에 쓴다. 값을 로그·픽스처에 남기지 않는다.
SUPABASE_SECRET_KEY=
# Kakao 연결 해제(계정 삭제, #106)의 관리자 키(Kakao Developers 앱 키 중 Admin 키, 서버 전용). 웹(계정 삭제)과 워커(연결 해제 재시도)가 읽는다.
# 비우면 Kakao 계정의 삭제는 "지금은 할 수 없음"이고, 워커의 Kakao 재시도는 완료되지 않는다. 값을 로그·픽스처에 남기지 않는다.
KAKAO_ADMIN_KEY=
# Kakao 로그인(#121, 웹 서버 전용): 앱이 직접 하는 OIDC 인가 코드 흐름의 REST API 키(= Supabase Kakao 제공자 Client ID)와 클라이언트 시크릿.
# 둘 중 하나라도 비우면 Kakao 로그인은 "지금은 로그인할 수 없습니다"다. 값을 로그·픽스처에 남기지 않는다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 복원 전 내보내기·복원 뒤 삭제 재적용(#106, accounts:export-deletions·accounts:replay-deletions)의 파일 절대경로. 실행할 때만 준다.
# 파일은 Google 해제용 토큰을 담는다 — 커밋·업로드하지 않고 쓰고 나면 지운다.
ACCOUNT_DELETIONS_FILE=
# 익명 요청 남용 방지(#125, 웹 서버 전용): 쿠키 `__Host-anon-id` 서명·쿠키 카운터 키·날짜별 IP HMAC 키를 이 값 하나에서 파생한다. 값은 openssl rand -hex 32.
# 비우면(또는 OPENAI_API_KEY가 없으면) 검색 POST /api/search는 503이다. 바꾸면 기존 쿠키는 새로 발급되고 그날 카운터는 새로 센다.
ANON_REQUEST_SECRET=
# 소개 화면 정정·삭제 요청 메일 주소(#127, 웹 서버 전용 — NEXT_PUBLIC_ 금지). 값은 여기·저장소 어디에도 쓰지 않는다(Vercel Production에만).
# 소개는 정적 페이지라 빌드 때 들어가므로 바꾸면 재배포해야 한다. 비우면 mailto 대신 "연락처 준비 중"을 보인다. E2E·테스트는 contact@example.com.
CONTACT_EMAIL=
# 골든셋 데이터 디렉터리(#147, packages/pipeline eval:*). 저장소 밖의 절대경로(필수). 기사 본문·제목·설명·초안·판정 진행을 여기에만 두며 커밋하지 않는다.
EVAL_DATA_DIR=
